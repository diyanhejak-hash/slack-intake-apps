# Copy jadi .env, isi dari Slack App yang sama dipakai Phase 0 (reuse, bukan App baru)
# Tambahkan redirect URL baru di App itu: slackintakeapps://callback
#
# PKCE (poin revisi keamanan) — App ini WAJIB diaktifkan "PKCE" dulu di Slack App dashboard
# (App Settings > OAuth & Permissions atau App Manifest, tergantung versi UI Slack) SEBELUM
# login bisa jalan. Begitu PKCE aktif, App jadi "public client" — SLACK_CLIENT_SECRET GAK
# DIPAKAI LAGI sama sekali (dihapus dari sini, dari kode, dan dari yang dipaket ke installer).
#
# Redirect pakai custom URI scheme (BUKAN http://localhost) — syarat "Use HTTPS For Your
# Features" di Manage Distribution Slack nolak http://localhost (dianggap redirect development
# doang). slackintakeapps:// didaftarkan otomatis ke OS lewat electron-builder (lihat
# "protocols" di package.json) — gak butuh port/server lokal lagi.
SLACK_CLIENT_ID=
SLACK_REDIRECT_URI=slackintakeapps://callback

# Cek update versi (opsional) — repo GitHub tempat rilis installer dipublish. Kalau repo-nya
# PRIVAT, GITHUB_RELEASES_TOKEN wajib diisi (fine-grained PAT, Contents: Read-only, scoped cuma
# ke repo ini — lihat SECURITY_AUDIT_2026-09-17.md di root project buat cara bikinnya).
GITHUB_REPO=
GITHUB_RELEASES_TOKEN=
