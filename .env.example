# Copy jadi .env, isi dari Slack App yang sama dipakai Phase 0 (reuse, bukan App baru)
# Tambahkan redirect URL baru di App itu: http://localhost:3737/callback
#
# PKCE (poin revisi keamanan) — App ini WAJIB diaktifkan "PKCE" dulu di Slack App dashboard
# (App Settings > OAuth & Permissions atau App Manifest, tergantung versi UI Slack) SEBELUM
# login bisa jalan. Begitu PKCE aktif, App jadi "public client" — SLACK_CLIENT_SECRET GAK
# DIPAKAI LAGI sama sekali (dihapus dari sini, dari kode, dan dari yang dipaket ke installer).
SLACK_CLIENT_ID=
SLACK_REDIRECT_URI=http://localhost:3737/callback
OAUTH_PORT=3737
