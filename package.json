{
  "name": "slack-intake-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HB Slack Intake — aplikasi desktop untuk mengelola intake produksi melalui Slack",
  "author": "Herald Entertainment",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm run wait-and-electron\"",
    "wait-and-electron": "wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .",
    "build:renderer": "vite build",
    "build": "npm run check && electron-builder",
    "build:win": "npm run check && electron-builder --win",
    "build:mac": "npm run check && electron-builder --mac",
    "build:linux": "npm run check && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test": "node test/regression.cjs",
    "test:smoke": "node test/run-electron-smoke.cjs",
    "check": "npm run typecheck && npm test && npm run build:renderer && npm run test:smoke"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/markdown": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@slack/socket-mode": "^3.0.1",
    "@slack/web-api": "^7.10.0",
    "dotenv": "^17.2.3",
    "lexical": "^0.50.0",
    "lucide-react": "^0.469.0",
    "mp4box": "^2.4.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@lexical/headless": "^0.50.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.heraldentertainment.slackintakeapps",
    "productName": "HB Slack Intake",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "Asset/HB-SLACK-INTAKE.png"
    ],
    "beforePack": "./electron/build-config.cjs",
    "extraResources": [
      {
        "from": ".packaging/runtime-config.json",
        "to": "runtime-config.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "protocols": {
      "name": "HB Slack Intake",
      "schemes": [
        "slackintakeapps"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "diyanhejak-hash",
      "repo": "slack-intake-apps"
    },
    "win": {
      "target": "nsis",
      "icon": "Asset/HB-SLACK-INTAKE.png",
      "artifactName": "HB Slack Intake v${version} win ${arch}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "identity": null,
      "icon": "Asset/HB-SLACK-INTAKE.png",
      "artifactName": "HB Slack Intake v${version} Mac ${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "Asset/HB-SLACK-INTAKE.png",
      "category": "Office"
    }
  }
}
